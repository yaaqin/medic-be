// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────
// ENUMS
// ─────────────────────────────────────

enum Role {
  PATIENT
  HOSPITAL_STAFF
  VERIFIED_DOCTOR
  ADMIN
}

enum EmergencyType {
  LIFE_THREATENING
  UNCONSCIOUS
  CRITICAL_SURGERY
}

enum EbgStatus {
  INITIATED
  COMPLETED
  EXPIRED
  FAILED
}

enum ExportRequesterType {
  PATIENT
  HOSPITAL
}

enum MedicalRecordStatus {
  ACTIVE
  REVOKED
}

enum RecordType {
  CONSULTATION
  LAB_RESULT
  PRESCRIPTION
  RADIOLOGY
  SURGERY
  VACCINATION
  OTHER
}

// ─────────────────────────────────────
// PATIENT
// ─────────────────────────────────────

model Patient {
  id             String   @id @default(uuid())
  patientCode    String   @unique // PAT-0001
  nikHash        String   @unique // sha256(NIK)
  ibuKandungHash String   // sha256(namaIbuKandung)
  walletPubkey   String   @unique
  name           String
  phone          String?
  email          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  records        MedicalRecord[]
  exportHistory  ExportHistory[]
  ebgLogs        EmergencyAccessLog[] @relation("PatientEbgLogs")

  @@index([nikHash])
  @@map("patients")
}

// ─────────────────────────────────────
// HOSPITAL
// ─────────────────────────────────────

model Hospital {
  id                 String   @id @default(uuid())
  hospitalCode       String   @unique // RSUD-B, PUSKESMAS-C
  name               String
  address            String?
  phone              String?
  email              String?

  // Sui wallet — gas sponsor untuk semua TX di hospital ini
  walletAddress      String   @unique // Sui address (0x...)
  walletEncryptedKey String   // AES-256-GCM encrypted private key
  walletKeyIv        String   // IV untuk decrypt (hex)

  isActive           Boolean  @default(true)
  registeredById     String?  // admin UUID yang daftarin
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  staff              HospitalStaff[]
  inviteCodes        HospitalInviteCode[]
  records            MedicalRecord[]
  accessLogs         RecordAccessLog[]

  @@map("hospitals")
}

// ─────────────────────────────────────
// HOSPITAL INVITE CODE
// ─────────────────────────────────────

model HospitalInviteCode {
  id         String    @id @default(uuid())
  code       String    @unique // random 8-char uppercase, e.g. "RSUD1A2B"
  hospitalId String
  hospital   Hospital  @relation(fields: [hospitalId], references: [id])
  role       Role      @default(HOSPITAL_STAFF)
  usedById   String?   // staff UUID yang pakai kode ini
  usedAt     DateTime?
  expiresAt  DateTime  // default 7 hari dari created
  createdAt  DateTime  @default(now())

  @@index([hospitalId])
  @@map("hospital_invite_codes")
}

// ─────────────────────────────────────
// HOSPITAL STAFF / DOCTOR
// ─────────────────────────────────────

model HospitalStaff {
  id               String    @id @default(uuid())
  staffCode        String    @unique // DOC-0001 / STF-0001
  name             String
  email            String    @unique
  passwordHash     String
  role             Role      @default(HOSPITAL_STAFF)
  hospitalId       String
  hospital         Hospital  @relation(fields: [hospitalId], references: [id])

  // Doctor-specific (nullable untuk non-doctor staff)
  nikHash          String?
  strNumber        String?   // Surat Tanda Registrasi
  sipNumber        String?   // Surat Izin Praktik
  specialization   String?
  isVerifiedDoctor Boolean   @default(false)
  verifiedAt       DateTime?
  verifiedById     String?   // admin UUID yang verifikasi

  inviteCodeUsed   String?   // kode invite yang dipakai saat register

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  recordsCreated   MedicalRecord[]      @relation("RecordCreatedByStaff")
  ebgLogsAsDoctor  EmergencyAccessLog[] @relation("DoctorEbgLogs")

  @@index([email])
  @@index([hospitalId])
  @@map("hospital_staff")
}

// ─────────────────────────────────────
// MEDICAL RECORD
// ─────────────────────────────────────

model MedicalRecord {
  id         String              @id @default(uuid())

  // on-chain record_id — format: REC-{HOSPITAL_CODE}-{YEAR}-{RANDOM}
  // contoh: REC-RSUD-2024-ABCD1234
  recordId   String              @unique

  recordType RecordType
  status     MedicalRecordStatus @default(ACTIVE)

  // Data on-chain reference
  ipfsRef    String   // IPFS CID dari encrypted blob
  dataHash   String   // SHA256(encrypted blob) — tamper detection
  txDigest   String   // TX hash dari create_record on-chain

  // Doctor reference — on-chain doctor_id (bukan FK ke HospitalStaff
  // karena sumber truth dokter ada di DoctorRegistry on-chain)
  doctorOnChainId  String   // doctor_id on-chain, e.g. "DOC-0001"

  // Optional: link ke staff lokal jika ada (untuk query internal)
  createdByStaffId String?
  createdByStaff   HospitalStaff? @relation("RecordCreatedByStaff", fields: [createdByStaffId], references: [id])

  // Relations
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id])

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Jika direvoke
  revokedAt     DateTime?
  revokeReason  String?
  revokeTxDigest String?  // TX hash dari revoke_record on-chain

  accessLogs RecordAccessLog[]

  @@index([patientId])
  @@index([hospitalId])
  @@index([doctorOnChainId])
  @@index([status])
  @@index([createdAt])
  @@map("medical_records")
}

// ─────────────────────────────────────
// RECORD ACCESS LOG
// ─────────────────────────────────────

// Mirror dari AccessLog on-chain — disimpan lokal untuk query cepat
// tanpa harus query blockchain tiap kali
model RecordAccessLog {
  id                 String   @id @default(uuid())

  // on-chain access_id — format: ACC-{TIMESTAMP}-{RANDOM}
  accessId           String   @unique

  patientNikHash     String
  accessingHospitalId String
  accessingHospital  Hospital @relation(fields: [accessingHospitalId], references: [id])

  // record yang diakses (bisa lebih dari satu dalam satu sesi)
  records            MedicalRecord[]

  purpose            String
  txDigest           String   // TX hash dari log_access on-chain

  createdAt          DateTime @default(now())

  @@index([patientNikHash])
  @@index([accessingHospitalId])
  @@index([createdAt])
  @@map("record_access_logs")
}

// ─────────────────────────────────────
// EXPORT HISTORY
// ─────────────────────────────────────

model ExportHistory {
  id            String              @id @default(uuid())
  exportCode    String              @unique // EXP-0001
  patientId     String
  patient       Patient             @relation(fields: [patientId], references: [id])
  requesterType ExportRequesterType
  requesterId   String
  fileSizeMb    Float
  costSgt       Float
  blockchainTx  String?
  ipfsRef       String?
  createdAt     DateTime            @default(now())

  @@index([patientId])
  @@map("export_history")
}

// ─────────────────────────────────────
// EMERGENCY BREAK GLASS
// ─────────────────────────────────────

model EmergencyAccessLog {
  id                    String        @id @default(uuid())
  ebgCode               String        @unique // EBG-2024-0001
  patientId             String
  patient               Patient       @relation("PatientEbgLogs", fields: [patientId], references: [id])
  doctorId              String
  doctor                HospitalStaff @relation("DoctorEbgLogs", fields: [doctorId], references: [id])
  hospitalId            String
  emergencyType         EmergencyType
  justification         String        // plaintext — untuk keperluan legal/audit
  justificationHash     String        // sha256(justification) — ini yang ke blockchain
  sessionId             String        @unique
  sessionUsed           Boolean       @default(false)
  sessionUsedAt         DateTime?
  status                EbgStatus     @default(INITIATED)
  recordsAccessed       String[]      // on-chain record_ids yang diakses
  blockchainTxInitiated String?
  blockchainTxCompleted String?
  witnessedBy           String?
  location              String?
  completedAt           DateTime?
  createdAt             DateTime      @default(now())

  @@index([patientId])
  @@index([doctorId])
  @@index([sessionId])
  @@index([status])
  @@map("emergency_access_logs")
}

// ─────────────────────────────────────
// FEE CONFIG HISTORY
// ─────────────────────────────────────

model FeeConfigHistory {
  id           String   @id @default(uuid())
  feeType      String
  oldValueSgt  Float
  newValueSgt  Float
  changedById  String
  blockchainTx String?
  createdAt    DateTime @default(now())

  @@map("fee_config_history")
}
